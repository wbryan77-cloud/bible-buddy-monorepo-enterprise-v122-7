# BibleBuddy — environment variable template (Phase 6F Part 15).
# Copy to .env for local development: cp .env.sample .env
# Never commit a real .env file — it is already gitignored.

# ---------------------------------------------------------------------------
# REQUIRED for the companion's Scripture/reasoning answers to work at all
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime mode / behavior flags (safe defaults shown — match render.yaml)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# BUDDY_RUNTIME is cosmetic after hard cutover — live path is always openAiFirstCompanionRuntime.
BUDDY_RUNTIME=legacy
BUDDY_TEMPLATE_PROSE=0
BUDDY_DISABLE_STUDY_FALLBACK=1
BUDDY_DEBUG=0
BUDDY_LIVE_TRACE=0
# BIBLEBUDDY_DISABLE_OPENAI=1   # uncomment to force offline/no-OpenAI mode for testing

# ---------------------------------------------------------------------------
# Admin API protection — leave unset locally (endpoints stay open on
# localhost); ALWAYS set at least one of these in any shared/deployed
# environment.
# ---------------------------------------------------------------------------
# BIBLE_AUTHORITY_ADMIN_TOKEN=
# Tester-facing Alpha public origin (https://your.domain — no trailing slash).
# When unset, invite links fall back to ALPHA_TESTER_BASE_URL / PUBLIC_APP_URL /
# RENDER_EXTERNAL_URL (Render hostname). Do not invent a brand domain here.
# PUBLIC_ALPHA_ORIGIN=
# ALPHA_TESTER_BASE_URL=
# PUBLIC_APP_URL=
# ALPHA_ADMIN_TOKEN=
# BETA_REVIEW_TOKEN=
# NOTE: ADMIN_PASSWORD is unused by runtime Admin auth — do not set it expecting protection.

# ---------------------------------------------------------------------------
# Optional providers — the app degrades gracefully without these (see
# ArchitectureScaleReadiness.md / ProviderReevaluation2026.md)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=            # email notifications (not required for Founder Alpha)
# TWILIO_ACCOUNT_SID=        # SMS notifications (not required for Founder Alpha)
# TWILIO_AUTH_TOKEN=
# YOUTUBE_API_KEY=           # only used by IOG/ICOJ source-investigation scripts, not the live answer path

# ---------------------------------------------------------------------------
# Scripture provider tuning (safe to leave at defaults)
# ---------------------------------------------------------------------------
# SCRIPTURE_API_BASE_URL=https://bible-api.com
# SCRIPTURE_API_TRANSLATION=kjv
# SCRIPTURE_API_TIMEOUT_MS=8000
# SCRIPTURE_CACHE_MAX_ENTRIES=2000
# SCRIPTURE_CACHE_TTL_MS=21600000
# BIBLE_TEXT_APPROVED_PROVIDER_URL=
# BIBLE_TEXT_APPROVED_PROVIDER_TIMEOUT_MS=8000
# LOCAL_KJV_CORPUS_FORCE_UNAVAILABLE=0   # set to 1 only to test the external-provider fallback path

# ---------------------------------------------------------------------------
# Persistence / durable companion memory (Phase 7C)
# When DATABASE_URL is set, durableUserMemory uses the Postgres document
# adapter. REDIS_URL remains optional/unused by the live chat path today.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# REDIS_URL=
